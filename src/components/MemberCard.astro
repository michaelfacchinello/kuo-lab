---
import type { CollectionEntry } from 'astro:content';
import Placeholder from './Placeholder.astro';

interface Props {
  entry: CollectionEntry<'people'>;
  bio?: string;
}

const { entry, bio } = Astro.props;
const { name, title, interests, email, website, github, scholar } = entry.data;
---

{/* Mini version of the PI profile: portrait photo beside the bio. */}
<article class="card member">
  <Placeholder label="Photo Here" ratio="3 / 4" class="member-photo" />

  <div class="member-body">
    <h3>{name}</h3>
    <p class="member-title small">{title}</p>

    {bio && <p class="small muted member-bio">{bio}</p>}

    {
      interests.length > 0 && (
        <ul class="tag-list member-interests">
          {interests.map((i) => (
            <li>
              <span class="tag">{i}</span>
            </li>
          ))}
        </ul>
      )
    }

    <ul class="link-list member-links">
      {email && <li><a href={`mailto:${email}`}>Email</a></li>}
      {website && <li><a href={website} rel="noopener">Website</a></li>}
      {scholar && <li><a href={scholar} rel="noopener">Scholar</a></li>}
      {github && <li><a href={github} rel="noopener">GitHub</a></li>}
    </ul>
  </div>
</article>

<style>
  .member {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr);
    gap: 1.15rem;
    align-items: start;
  }

  /* Portrait with the site's standard rounded corners, like the PI photo. */
  .member :global(.member-photo) {
    width: 100%;
  }

  .member-body {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .member-title {
    font-weight: 600;
    color: var(--accent-2);
  }

  .member-bio {
    margin-top: 0.15rem;
  }

  .member-interests,
  .member-links {
    margin-top: 0.35rem;
  }

  .member-links {
    margin-top: auto;
    padding-top: 0.5rem;
    font-weight: 600;
  }

  /* Very narrow screens: stack the photo above the text. */
  @media (max-width: 430px) {
    .member {
      grid-template-columns: 1fr;
    }

    .member :global(.member-photo) {
      max-width: 200px;
    }
  }
</style>
