---
import type { GetStaticPaths } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { url } from '../../lib/url';
import { formatDate } from '../../lib/date';

export const getStaticPaths: GetStaticPaths = async () => {
  const news = await getCollection('news');
  return news.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
};

interface Props {
  entry: CollectionEntry<'news'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.summary}>
  <article class="section">
    <div class="container container--narrow">
      <p class="back small">
        <a href={url('/news')}>← All news</a>
      </p>

      <time class="date" datetime={entry.data.date.toISOString()}>
        {formatDate(entry.data.date)}
      </time>
      <h1 class="post-title">{entry.data.title}</h1>

      {
        entry.data.tags.length > 0 && (
          <ul class="tag-list post-tags">
            {entry.data.tags.map((tag) => (
              <li>
                <span class="tag">{tag}</span>
              </li>
            ))}
          </ul>
        )
      }

      <div class="markdown post-body">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .back {
    margin-bottom: 1.5rem;
    font-weight: 600;
  }

  .post-title {
    margin-block: 0.35rem 0.75rem;
    font-size: clamp(1.75rem, 1.3rem + 2vw, 2.5rem);
  }

  .post-body {
    margin-top: 1.75rem;
  }
</style>
